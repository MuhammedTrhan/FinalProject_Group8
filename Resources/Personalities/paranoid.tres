[resource]
script = ExtResource("1_script")
personality = 1
display_name = "The Scary One"
dossier_text = "I absolutely do not want to be seen wandering around this guy. He moves so erratically, constantly stopping and doing these quick 180-degree turns. You can't trick or distract him at all. One day, I used pure stealth and used the hiding spots to follow him only to find out he was throwing something's pieces into different garbage cans. He has this massive vision cone, and if you get caught in it for more than one single second, it triggers an immediate lockdown."
