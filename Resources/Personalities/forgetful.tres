[resource]
script = ExtResource("1_script")
display_name = "The Happy One"
dossier_text = "He just walks aimlessly humming this happy little tune, but he always forgets to close the doors behind him. You can easily stalk him, but you have to stay far back in his outer ring until he accidentally drops his crowbar. You have to be super careful, though. If you step into his inner space, he snaps into a totally aggressive personality and locks you in."
