idle_sheet = ExtResource("3_idle")
walk_sheet = ExtResource("4_walk")
slash_sheet = ExtResource("5_slash")
sit_sheet = ExtResource("6_sit")
move_speed = 80.0
chase_speed = 110.0
pause_chance = 0.35
view_distance = 140.0
fov_degrees = 70.0
detect_dwell = 1.6
leave_door_open_chance = 0.6
