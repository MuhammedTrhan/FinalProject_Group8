# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf
*.png filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.svg filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.res filter=lfs diff=lfs merge=lfs -text
*.stex filter=lfs diff=lfs merge=lfs -text
# The exported Windows build - 116 MB, well past GitHub's 100 MB
# per-file limit, so it can only live here through LFS.
*.exe filter=lfs diff=lfs merge=lfs -text

# NOTE: *.tres and *.import are deliberately NOT tracked by LFS.
# Both are small text files. Putting *.import in LFS breaks texture importing
# for anyone who clones without running `git lfs pull`, and *.tres is the
# format used for every ItemData / PersonalityProfile resource in this project.
